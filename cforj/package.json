{
  "name": "cforj-embed",
  "version": "0.1.0",
  "private": true,
  "description": "cforj-embed — standalone course authoring tool for LMS deployment",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/cforj-embed"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm --filter @course-studio/studio dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
