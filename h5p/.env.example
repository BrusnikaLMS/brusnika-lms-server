# H5P Server Environment Variables

# Node environment
NODE_ENV=production

# Server Port (внутренний порт контейнера)
PORT=8088

# Temp uploads
TEMP_UPLOADS=true

# CORS: разрешённые origins (через запятую)
# Укажите домены, с которых разрешены запросы к H5P API
CORS_ORIGINS=

# Debug (раскомментируйте для отладки)
# DEBUG=i18n,h5p:*

# ========================================
# Docker & Traefik Configuration
# ========================================

# Домен для H5P
H5P_DOMAIN=

# Email для Let's Encrypt (для автоматических SSL сертификатов)
LETSENCRYPT_EMAIL=

# Секретный ключ для сессий (ВАЖНО: сгенерируйте уникальный в production!)
SESSION_SECRET=h5p-production-secret-change-this-to-random-string

# Доверять прокси (nginx/traefik) для правильной работы secure cookies
TRUST_PROXY=1

# Cookie domain для поддоменов (опционально, если нужны общие cookie между поддоменами)
# COOKIE_DOMAIN=